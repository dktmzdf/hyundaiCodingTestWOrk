{
  "lessonId": 181887,
  "title": "홀수 vs 짝수",
  "type": "function",
  "signature": [
    "num_list"
  ],
  "cases": [
    {
      "name": "예제 1",
      "args": [
        "[4, 2, 6, 1, 7, 6]"
      ],
      "expected": "17",
      "source": "official"
    },
    {
      "name": "예제 2",
      "args": [
        "[-1, 2, 5, 6, 3]"
      ],
      "expected": "8",
      "source": "official"
    },
    {
      "name": "최소 길이 5, 짝수 인덱스 합이 큼",
      "why": "길이 하한 경계와 짝수합 우세 케이스 검증",
      "args": [
        "[9, 9, -9, -9, 0]"
      ],
      "expected": "0",
      "source": "ai"
    },
    {
      "name": "모두 음수",
      "why": "음수 원소들로 합이 음수가 되는 경우 검증",
      "args": [
        "[-9, -9, -9, -9, -9]"
      ],
      "expected": "-18",
      "source": "ai"
    },
    {
      "name": "모든 원소 0",
      "why": "합이 0으로 동일한 경우(동점 처리) 검증",
      "args": [
        "[0, 0, 0, 0, 0]"
      ],
      "expected": "0",
      "source": "ai"
    },
    {
      "name": "길이 6, 홀짝합 동일",
      "why": "두 값이 같을 때 그 값을 반환하는지 검증",
      "args": [
        "[1, 1, 1, 1, 1, 1]"
      ],
      "expected": "3",
      "source": "ai"
    },
    {
      "name": "경계값 최대치 혼합",
      "why": "최대/최소 경계값이 섞여 짝수합이 더 큰 경우 검증",
      "args": [
        "[9, -9, -9, 9, 0, 9]"
      ],
      "expected": "9",
      "source": "ai"
    }
  ]
}
