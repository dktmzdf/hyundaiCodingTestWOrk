{
  "lessonId": 43165,
  "title": "타겟 넘버",
  "type": "function",
  "signature": [
    "numbers",
    "target"
  ],
  "cases": [
    {
      "name": "예제 1",
      "args": [
        "[1, 1, 1, 1, 1]",
        "3"
      ],
      "expected": "5",
      "source": "official"
    },
    {
      "name": "예제 2",
      "args": [
        "[4, 1, 2, 1]",
        "4"
      ],
      "expected": "2",
      "source": "official"
    },
    {
      "name": "최소 길이 n=2",
      "why": "numbers 개수 하한(2) 경계 테스트",
      "args": [
        "[1, 1]",
        "2"
      ],
      "expected": "1",
      "source": "ai"
    },
    {
      "name": "숫자 최대값 50 경계",
      "why": "각 숫자의 상한(50)과 딱 맞는 target 조합 테스트",
      "args": [
        "[50, 50]",
        "100"
      ],
      "expected": "1",
      "source": "ai"
    },
    {
      "name": "모두 더하기만 유일해",
      "why": "전부 +로만 답이 나오는 유일 경로 케이스, 답이 여럿으로 갈리지 않는지 확인",
      "args": [
        "[1, 2, 3]",
        "6"
      ],
      "expected": "1",
      "source": "ai"
    },
    {
      "name": "총합 초과로 불가능",
      "why": "target이 numbers 총합보다 커서 어떤 조합으로도 도달 불가능한 경우(0 반환) 확인",
      "args": [
        "[1, 2, 3]",
        "10"
      ],
      "expected": "0",
      "source": "ai"
    },
    {
      "name": "중복값으로 여러 경로 존재",
      "why": "같은 값이 반복될 때 target을 만드는 경로가 여러 개로 갈리는 지점 테스트",
      "args": [
        "[1, 1, 1]",
        "1"
      ],
      "expected": "3",
      "source": "ai"
    }
  ]
}
