{
  "lessonId": 181858,
  "title": "무작위로 K개의 수 뽑기",
  "type": "function",
  "signature": [
    "arr",
    "k"
  ],
  "cases": [
    {
      "name": "예제 1",
      "args": [
        "[0, 1, 1, 2, 2, 3]",
        "3"
      ],
      "expected": "[0, 1, 2]",
      "source": "official"
    },
    {
      "name": "예제 2",
      "args": [
        "[0, 1, 1, 1, 1]",
        "4"
      ],
      "expected": "[0, 1, -1, -1]",
      "source": "official"
    },
    {
      "name": "길이1배열",
      "why": "arr 길이가 1인 최소 경계값",
      "args": [
        "[5]",
        "1"
      ],
      "expected": "[5]",
      "source": "ai"
    },
    {
      "name": "k보다훨씬많은고유값",
      "why": "k개를 채우고 남은 원소는 무시되는지 확인",
      "args": [
        "[1, 2, 3, 4, 5]",
        "2"
      ],
      "expected": "[1, 2]",
      "source": "ai"
    },
    {
      "name": "모두같은값",
      "why": "중복만 있는 경우 나머지가 -1로 채워지는지 확인",
      "args": [
        "[7, 7, 7, 7]",
        "3"
      ],
      "expected": "[7, -1, -1]",
      "source": "ai"
    },
    {
      "name": "0포함역순",
      "why": "0을 포함한 역순 배열에서 정상 동작 확인",
      "args": [
        "[3, 2, 1, 0]",
        "4"
      ],
      "expected": "[3, 2, 1, 0]",
      "source": "ai"
    },
    {
      "name": "k1단일중복",
      "why": "k=1이고 중복값이 반복되는 최소 경계 케이스",
      "args": [
        "[9, 9, 9]",
        "1"
      ],
      "expected": "[9]",
      "source": "ai"
    }
  ]
}
