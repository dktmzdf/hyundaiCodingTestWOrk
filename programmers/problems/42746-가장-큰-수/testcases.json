{
  "lessonId": 42746,
  "title": "가장 큰 수",
  "type": "function",
  "signature": [
    "numbers"
  ],
  "cases": [
    {
      "name": "예제 1",
      "args": [
        "[6, 10, 2]"
      ],
      "expected": "\"6210\"",
      "source": "official"
    },
    {
      "name": "예제 2",
      "args": [
        "[3, 30, 34, 5, 9]"
      ],
      "expected": "\"9534330\"",
      "source": "official"
    },
    {
      "name": "내 케이스 1",
      "source": "user",
      "args": [
        "[6, 2, 90]"
      ],
      "expected": "'9062'"
    },
    {
      "name": "원소 하나 0",
      "why": "길이 최소값이면서 원소가 0 하나뿐인 경계 케이스",
      "args": [
        "[0]"
      ],
      "expected": "\"0\"",
      "source": "ai"
    },
    {
      "name": "전부 0",
      "why": "그대로 이어 붙이면 \"000\"이 되므로 \"0\"으로 합쳐야 하는 케이스",
      "args": [
        "[0, 0, 0]"
      ],
      "expected": "\"0\"",
      "source": "ai"
    },
    {
      "name": "최댓값 1000과 접두 관계",
      "why": "1, 10, 100, 1000처럼 접두사가 겹치는 값들의 정렬 기준(a+b vs b+a)을 검증",
      "args": [
        "[1000, 100, 10, 1]"
      ],
      "expected": "\"1101001000\"",
      "source": "ai"
    },
    {
      "name": "접두사 관계 10과 101",
      "why": "단순 문자열 길이·사전순 비교로는 틀리기 쉬운 쌍으로, 101이 앞에 와야 함",
      "args": [
        "[10, 101]"
      ],
      "expected": "\"10110\"",
      "source": "ai"
    },
    {
      "name": "40, 403, 404 조합",
      "why": "앞자리가 같은 세 수의 상대 순서가 서로 다르게 결정되는 지점",
      "args": [
        "[40, 403, 404]"
      ],
      "expected": "\"40440403\"",
      "source": "ai"
    }
  ]
}
