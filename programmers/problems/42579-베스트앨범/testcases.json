        "[500, 600, 150, 800, 2500]"
      ],
      "expected": "[4, 1, 3, 0]",
      "source": "official"
    },
    {
      "name": "단일곡 최소 길이",
      "why": "genres/plays 길이가 1인 최소 경계값 확인",
      "args": [
        "[\"classic\"]",
        "[100]"
      ],
      "expected": "[0]",
      "source": "ai"
    },
    {
      "name": "장르당 곡 하나씩",
      "why": "모든 장르에 곡이 1개뿐일 때 정렬 순서만으로 결과가 결정되는지 확인",
      "args": [
        "[\"classic\", \"pop\", \"rock\"]",
        "[100, 200, 300]"
      ],
      "expected": "[2, 1, 0]",
      "source": "ai"
    },
    {
      "name": "곡 재생횟수 동률 시 번호 우선",
      "why": "같은 장르 내 재생횟수가 같을 때 고유번호가 낮은 곡이 먼저 오는지 확인",
      "args": [
        "[\"classic\", \"classic\", \"classic\"]",
        "[100, 100, 50]"
      ],
      "expected": "[0, 1]",
      "source": "ai"
    },
    {
      "name": "오름차순 재생횟수",
      "why": "입력이 재생횟수 오름차순(역순 정렬 상태)일 때도 올바르게 상위 2곡을 뽑는지 확인",
      "args": [
        "[\"pop\", \"pop\", \"pop\", \"pop\"]",
        "[10, 20, 30, 40]"
      ],
      "expected": "[3, 2]",
      "source": "ai"
    },
    {
      "name": "두 장르 각 3곡 혼합 배치",
      "why": "장르가 인터리빙되어 섞여 있고 각 장르에 3곡 이상 있을 때 정렬 및 상위 2곡 선택이 올바른지 확인",
      "args": [
        "[\"classic\", \"pop\", \"classic\", \"pop\", \"classic\", \"pop\"]",
        "[100, 200, 50, 300, 150, 100]"
      ],
      "expected": "[3, 1, 4, 0]",
      "source": "ai"
    }
  ]
